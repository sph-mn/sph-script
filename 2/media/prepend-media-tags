#!/usr/bin/env node
"use strict"

const fs = require("node:fs")
const path = require("node:path")
const {spawnSync} = require("node:child_process")

const BASE_PIXELS = 1920 * 1080

class UnsupportedAnimation extends Error {}

function require_bytes(buffer, offset, count) {
  if (offset < 0 || count < 0 || offset + count > buffer.length) {
    throw new Error("Truncated image")
  }
}

function image_kind(buffer) {
  if (buffer.length >= 3 && buffer.subarray(0, 3).equals(Buffer.from([0xff, 0xd8, 0xff]))) return "jpeg"
  if (buffer.length >= 8 && buffer.subarray(0, 8).equals(Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]))) return "png"
  if (buffer.length >= 12 && buffer.toString("ascii", 0, 4) === "RIFF" && buffer.toString("ascii", 8, 12) === "WEBP") return "webp"
  return null
}

function png_properties(data) {
  let offset = 8
  let width, height, bitdepth, sampling, palette_colors
  let seen_header = false, seen_data = false, seen_end = false

  while (offset + 12 <= data.length) {
    const length = data.readUInt32BE(offset)
    const type = data.toString("ascii", offset + 4, offset + 8)
    const start = offset + 8
    require_bytes(data, start, length + 4)

    if (!seen_header && type !== "IHDR") throw new Error("Missing PNG header")
    if (type === "IHDR") {
      if (seen_header || length !== 13) throw new Error("Invalid PNG header")
      seen_header = true
      width = data.readUInt32BE(start)
      height = data.readUInt32BE(start + 4)
      bitdepth = data[start + 8]
      const color_type = data[start + 9]
      const permitted_depths = {0: [1, 2, 4, 8, 16], 2: [8, 16], 3: [1, 2, 4, 8], 4: [8, 16], 6: [8, 16]}
      if (!permitted_depths[color_type]?.includes(bitdepth)) throw new Error("Invalid PNG color depth")
      if (color_type === 0 || color_type === 4) sampling = "gray"
      else if (color_type === 2 || color_type === 6) sampling = "444"
      else if (color_type === 3) {
        sampling = "indexed"
        bitdepth = 8 // Palette entries contain 8-bit samples.
      } else throw new Error("Unsupported PNG color type")
    } else if (type === "PLTE") {
      if (length % 3 !== 0 || length < 3 || length > 768) throw new Error("Invalid PNG palette")
      palette_colors = length / 3
    } else if (type === "acTL") {
      throw new UnsupportedAnimation("Animated PNG")
    } else if (type === "IDAT") {
      seen_data = true
    } else if (type === "IEND") {
      seen_end = true
      break
    }
    offset = start + length + 4
  }
  if (!seen_header || !seen_data || !seen_end || !width || !height) throw new Error("Incomplete PNG")
  if (sampling === "indexed" && !palette_colors) throw new Error("Missing PNG palette")
  return {width, height, bitdepth, sampling, palette_colors, encoding: "png"}
}

function jpeg_properties(data) {
  let offset = 2
  let width, height, bitdepth, sampling_density
  let payload_bytes = 0
  let ended = false

  while (offset < data.length) {
    if (data[offset] !== 0xff) throw new Error("Invalid JPEG marker")
    while (offset < data.length && data[offset] === 0xff) offset++
    require_bytes(data, offset, 1)
    const marker = data[offset++]
    if (marker === 0xd9) { ended = true; break }
    if (marker === 0xd8 || marker === 0x01 || (marker >= 0xd0 && marker <= 0xd7)) continue

    require_bytes(data, offset, 2)
    const length = data.readUInt16BE(offset)
    if (length < 2) throw new Error("Invalid JPEG segment")
    require_bytes(data, offset, length)
    const start = offset + 2

    if (marker >= 0xc0 && marker <= 0xcf && ![0xc4, 0xc8, 0xcc].includes(marker)) {
      require_bytes(data, start, 6)
      bitdepth = data[start]
      height = data.readUInt16BE(start + 1)
      width = data.readUInt16BE(start + 3)
      const components = data[start + 5]
      if (!components || length < 8 + 3 * components) throw new Error("Invalid JPEG components")
      let max_h = 1, max_v = 1, component_samples = 0
      const factors = []
      for (let i = 0; i < components; i++) {
        const hv = data[start + 7 + i * 3]
        const h = hv >>> 4, v = hv & 15
        if (!h || !v) throw new Error("Invalid JPEG sampling")
        factors.push(h * v)
        max_h = Math.max(max_h, h)
        max_v = Math.max(max_v, v)
      }
      for (const factor of factors) component_samples += factor / (max_h * max_v)
      sampling_density = component_samples
    }

    offset += length
    if (marker === 0xda) {
      const scan_start = offset
      while (offset < data.length) {
        const ff = data.indexOf(0xff, offset)
        if (ff < 0) break
        let next = ff + 1
        while (next < data.length && data[next] === 0xff) next++
        if (next >= data.length) break
        const code = data[next]
        if (code === 0x00 || (code >= 0xd0 && code <= 0xd7)) {
          offset = next + 1
          continue
        }
        payload_bytes += ff - scan_start
        offset = ff
        break
      }
      if (offset >= data.length) throw new Error("Missing JPEG end marker")
    }
  }
  if (!ended || !width || !height || !bitdepth || !sampling_density || !payload_bytes) {
    throw new Error("Incomplete JPEG")
  }
  const sampling = sampling_density === 1 ? "gray" : sampling_density <= 1.5 ? "420" : sampling_density <= 2 ? "422" : "444"
  return {width, height, bitdepth, sampling, sampling_density, payload_bytes, encoding: "jpeg"}
}

function webp_properties(data) {
  const end = 8 + data.readUInt32LE(4)
  if (end > data.length) throw new Error("Truncated WebP")
  let offset = 12
  let width, height, encoding, payload_bytes = 0
  let frames = 0

  while (offset + 8 <= end) {
    const type = data.toString("ascii", offset, offset + 4)
    const length = data.readUInt32LE(offset + 4)
    const start = offset + 8
    if (start + length > end) throw new Error("Invalid WebP chunk")

    if (type === "VP8X") {
      require_bytes(data, start, 10)
      if (length !== 10) throw new Error("Invalid WebP canvas header")
      if (data[start] & 0x02) throw new UnsupportedAnimation("Animated WebP")
      width = 1 + data.readUIntLE(start + 4, 3)
      height = 1 + data.readUIntLE(start + 7, 3)
    } else if (type === "ANIM" || type === "ANMF") {
      throw new UnsupportedAnimation("Animated WebP")
    } else if (type === "VP8 ") {
      require_bytes(data, start, 10)
      if (data[start + 3] !== 0x9d || data[start + 4] !== 0x01 || data[start + 5] !== 0x2a) {
        throw new Error("Invalid lossy WebP frame")
      }
      width ||= data.readUInt16LE(start + 6) & 0x3fff
      height ||= data.readUInt16LE(start + 8) & 0x3fff
      encoding = "webp-lossy"
      payload_bytes += length
      frames++
    } else if (type === "VP8L") {
      require_bytes(data, start, 5)
      if (data[start] !== 0x2f) throw new Error("Invalid lossless WebP frame")
      const packed = data.readUInt32LE(start + 1)
      width ||= (packed & 0x3fff) + 1
      height ||= ((packed >>> 14) & 0x3fff) + 1
      encoding = "webp-lossless"
      frames++
    }
    offset = start + length + (length & 1)
  }
  if (frames !== 1 || !width || !height) throw new Error("Invalid WebP image")
  return {width, height, bitdepth: 8, sampling: encoding === "webp-lossy" ? "420" : "444", payload_bytes, encoding}
}

function get_image_quality_score({width, height, bitdepth, sampling, sampling_density, palette_colors, payload_bytes, encoding}) {
  const resolution = width * height
  const resolution_factor = Math.log2(1 + resolution / BASE_PIXELS)
  const bitdepth_factor = Math.log2(bitdepth / 8)
  const densities = {gray: 1, "420": 1.5, "422": 2, "444": 3, indexed: 1}
  const colors = {gray: 0, "420": 0.6, "422": 0.8, "444": 1}
  const color_factor = sampling === "indexed" ? Math.log2(palette_colors) / 24 : colors[sampling]

  let compression_factor = 2
  if (encoding === "jpeg" || encoding === "webp-lossy") {
    const efficiency = encoding === "jpeg" ? 1 : 1.35
    const density = sampling_density || densities[sampling]
    const optimal_bpp = (bitdepth / 8) * (density / 1.5) / efficiency
    const ratio = (8 * payload_bytes / resolution) / optimal_bpp
    compression_factor = 2 * ratio * ratio / (1 + ratio * ratio)
  }

  const quality = 0.55 * resolution_factor + 0.15 * bitdepth_factor +
    0.10 * color_factor + 0.20 * compression_factor
  return Math.max(0, Math.round(quality * 10 - 1))
}

function parse_numeric(value, fallback) {
  const n = Number(value)
  return Number.isFinite(n) && n > 0 ? n : fallback
}

function parse_frame_rate(value) {
  if (typeof value !== "string") return null
  const parts = value.split("/")
  const value_number = parts.length === 2 ? Number(parts[0]) / Number(parts[1]) : Number(value)
  return Number.isFinite(value_number) && value_number > 0 ? value_number : null
}

function get_duration_string(duration) {
  if (!duration) return "d0"
  const durations = [100, 500, 2500, 5000]
  for (let i = 0; i < durations.length; i++) {
    if (duration < durations[i]) return "d" + (i + 1)
  }
  return "d" + durations.length
}

function get_video_quality_score(width, height, framerate, bitdepth, bitrate, codec) {
  const efficiencies = {av1: 1.5, h264: 1, h266: 2, hevc: 1.7, vp8: 0.9, vp9: 1.3}
  const optimal_bitrate = width * height * bitdepth * framerate / (efficiencies[codec] || 0.8)
  const bitrate_factor = 2 / (1 + Math.exp(-0.001 * (bitrate - optimal_bitrate)))
  const resolution_factor = Math.log2(1 + width * height / BASE_PIXELS)
  const framerate_factor = Math.log2(1 + framerate / 30)
  const bitdepth_factor = Math.log2((bitdepth - 6) / 2)
  const quality = 0.4 * resolution_factor + 0.3 * framerate_factor +
    0.2 * bitdepth_factor + 0.1 * bitrate_factor
  return Math.max(0, Math.round(quality * 10 - 1))
}

function video_properties(file_path, file_size) {
  const cmd = [
    "-v", "error", "-select_streams", "v:0",
    "-show_entries", "stream=width,height,codec_name,bits_per_raw_sample,pix_fmt,bit_rate,r_frame_rate,avg_frame_rate,duration:format=duration,bit_rate,format_name",
    "-of", "json", file_path
  ]
  const result = spawnSync("ffprobe", cmd, {encoding: "utf8", maxBuffer: 1024 * 1024})
  if (result.status !== 0) return null
  let data
  try { data = JSON.parse(result.stdout) } catch { return null }
  const stream = data.streams?.[0]
  if (!stream?.width || !stream?.height || !stream.codec_name) return null
  const format = data.format || {}
  if ((format.format_name || "").split(",").some(name => name === "image2" || name === "gif" || name.endsWith("_pipe"))) return null

  const duration = parse_numeric(stream.duration, parse_numeric(format.duration, 0))
  const pix_depth = Number((stream.pix_fmt || "").match(/(?:9|10|12|14|16)(?=le$|be$|$)/)?.[0]) || 8
  const bitdepth = Math.max(8, parse_numeric(stream.bits_per_raw_sample, pix_depth))
  const bitrate = parse_numeric(stream.bit_rate, parse_numeric(format.bit_rate, duration ? 8 * file_size / duration : 1000))
  const framerate = parse_frame_rate(stream.r_frame_rate) || parse_frame_rate(stream.avg_frame_rate) || 15
  return {width: stream.width, height: stream.height, bitdepth, bitrate, framerate, codec: stream.codec_name, duration}
}

function get_tag(file_path, file_size) {
  const fd = fs.openSync(file_path, "r")
  const header = Buffer.alloc(12)
  try { fs.readSync(fd, header, 0, 12, 0) } finally { fs.closeSync(fd) }
  const kind = image_kind(header)
  if (kind) {
    const data = fs.readFileSync(file_path)
    const props = kind === "jpeg" ? jpeg_properties(data) : kind === "png" ? png_properties(data) : webp_properties(data)
    return "q" + get_image_quality_score(props)
  }
  const video = video_properties(file_path, file_size)
  if (!video) return null
  return "q" + get_video_quality_score(video.width, video.height, video.framerate,
    video.bitdepth, video.bitrate, video.codec) + get_duration_string(video.duration)
}

function add_tag(file_path, tag, dry_run) {
  const dirname = path.dirname(file_path)
  const basename = path.basename(file_path).replace(/^q\d+(?:d\d+)?\./, "")
  const new_path = path.join(dirname, tag + "." + basename)
  if (new_path === file_path) return
  if (fs.existsSync(new_path)) throw new Error("Target already exists: " + new_path)
  if (dry_run) console.log(JSON.stringify(file_path) + " -> " + JSON.stringify(new_path))
  else fs.renameSync(file_path, new_path)
}

function list_scores() {
  const resolutions = [[640, 480], [1920, 1080], [3840, 2160], [7680, 4320]]
  for (const [width, height] of resolutions) {
    for (const framerate of [30, 60, 120]) {
      for (const bitdepth of [8, 10]) {
        for (const codec of ["h264", "av1"]) {
          for (const bitrate of [9000000, 25000000, 75000000, 100000000, 200000000]) {
            console.log(`video ${width}x${height} ${framerate} ${bitdepth} ${bitrate} ${codec} -> ${get_video_quality_score(width, height, framerate, bitdepth, bitrate, codec)}`)
          }
        }
      }
    }
    for (const [encoding, sampling, bitdepth] of [["jpeg", "420", 8], ["webp-lossy", "420", 8], ["png", "444", 8], ["png", "444", 16], ["webp-lossless", "444", 8]]) {
      for (const bpp of [0.5, 1, 2]) {
        if (encoding === "png" || encoding === "webp-lossless") {
          if (bpp !== 0.5) continue
          console.log(`image ${width}x${height} ${bitdepth} ${encoding} -> ${get_image_quality_score({width, height, bitdepth, encoding, sampling})}`)
        } else {
          const payload_bytes = width * height * bpp / 8
          console.log(`image ${width}x${height} ${bitdepth} ${encoding} ${bpp} bpp -> ${get_image_quality_score({width, height, bitdepth, encoding, sampling, payload_bytes})}`)
        }
      }
    }
  }
}

async function main() {
  const args = process.argv.slice(2)
  const options = {}
  let index = 0
  while (index < args.length && (args[index] === "-d" || args[index] === "-l")) {
    options[args[index]] = true
    index++
  }
  const rest = args[index] === "--" ? args.slice(index + 1) : args.slice(index)
  if (options["-l"]) { list_scores(); return }
  if (!rest.length) {
    console.log("usage: prepend-media-tags [-d|-l] files ...")
    console.log("  -d  dry-run")
    console.log("  -l  list predefined video and image quality scores")
    process.exitCode = 1
    return
  }
  for (const file_path of rest) {
    try {
      const stat = fs.statSync(file_path)
      if (!stat.isFile()) continue
      const tag = get_tag(file_path, stat.size)
      if (tag) add_tag(file_path, tag, !!options["-d"])
    } catch (error) {
      if (error.code === "ENOENT" || error instanceof UnsupportedAnimation) continue
      console.error(`${file_path}: ${error.message}`)
      process.exitCode = 1
    }
  }
}

main().catch(error => { console.error(error.message); process.exitCode = 1 })
