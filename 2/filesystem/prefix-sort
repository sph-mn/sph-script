#!/usr/bin/env node

const fs = require("node:fs");
const path = require("node:path");

function parse_arguments(values) {
  let run = false;
  let delimiter = ".";
  let index = 0;

  while (index < values.length && values[index][0] === "-") {
    if (values[index] === "-r") {
      run = true;
      index += 1;
    } else if (values[index] === "-d") {
      delimiter = values[index + 1];
      index += 2;
    } else {
      throw new Error("unknown option: " + values[index]);
    }
  }

  return {
    run,
    delimiter,
    paths: values.slice(index)
  };
}

function make_actions(delimiter, paths) {
  const groups = new Map();

  for (const value of paths) {
    const source = path.resolve(value);
    const target = path.join(
      path.dirname(source),
      path.basename(source).split(delimiter, 1)[0]
    );

    if (source === target)
      continue;

    if (!groups.has(target))
      groups.set(target, []);

    groups.get(target).push(source);
  }

  return [...groups]
    .filter(([, sources]) => sources.length > 1)
    .map(([target, sources]) => ({target, sources}));
}

function verify_actions(actions) {
  for (const action of actions) {
    if (fs.existsSync(action.target) && !fs.statSync(action.target).isDirectory())
      throw new Error("target is not a directory: " + action.target);

    for (const source of action.sources) {
      const destination = path.join(action.target, path.basename(source));

      fs.statSync(source);

      if (fs.existsSync(destination))
        throw new Error("destination exists: " + destination);
    }
  }
}

function prefix_sort(run, delimiter, paths) {
  const actions = make_actions(delimiter, paths);

  verify_actions(actions);

  for (const action of actions) {
    if (run) {
      if (!fs.existsSync(action.target))
        fs.mkdirSync(action.target);

      for (const source of action.sources)
        fs.renameSync(source, path.join(action.target, path.basename(source)));
    } else {
      if (!fs.existsSync(action.target))
        console.log("mkdir", action.target);

      for (const source of action.sources)
        console.log("rename", source, path.join(action.target, path.basename(source)));
    }
  }
}

const options = parse_arguments(process.argv.slice(2));

prefix_sort(options.run, options.delimiter, options.paths);