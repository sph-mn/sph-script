#!/usr/bin/env node
const fs = require("node:fs/promises")
const {COPYFILE_FICLONE} = require("node:fs").constants
const os = require("node:os")
const path = require("node:path")
const {execFile, execFileSync} = require("node:child_process")
const execute = require("node:util").promisify(execFile)
function parse_options(args) {
  let run = false
  let trigger = false
  let index = 0
  while (index < args.length) {
    const arg = args[index]
    if (arg === "--") {
      index += 1
      break
    }
    if (arg.length !== 2 || !arg.startsWith("-")) break
    if (arg === "-r") run = true
    else if (arg === "-t") trigger = true
    else throw new Error("unknown option: " + arg)
    index += 1
  }
  return {run, trigger, names: args.slice(index)}
}
async function try_path(operation, filename) {
  try {
    return await operation(filename)
  } catch (error) {
    if (error.code !== "ENOENT" && error.code !== "ENOTDIR") throw error
    return null
  }
}
async function mount_point(uuid) {
  try {
    const {stdout} = await execute("findmnt",
      ["--json", "--first-only", "--output", "TARGET", "--source", "/dev/disk/by-uuid/" + uuid])
    return JSON.parse(stdout).filesystems[0].target
  } catch (error) {
    if (error.code !== 1) throw error
    return null
  }
}
async function mount_points() {
  const text = await fs.readFile("/proc/self/mountinfo", "utf8")
  return new Set(text.trimEnd().split("\n").map(line => line.split(" ")[4].replace(/\\([0-7]{3})/g,
    (_, value) => String.fromCharCode(parseInt(value, 8)))))
}
// All filters match source-relative paths beginning with "/" and without a trailing slash.
// includes selects exact directory paths; excludes matches literal substrings.
// include_filter and exclude_filter use JavaScript regular expressions.
// Only excludes applies throughout selected subtrees. The source root is not selected.
function compile_rules(entry) {
  return {includes: entry.includes, excludes: entry.excludes,
    include_filter: entry.include_filter?.map(pattern => new RegExp(pattern)),
    exclude_filter: entry.exclude_filter?.map(pattern => new RegExp(pattern))}
}
function excluded(relative, rules) {
  return rules.excludes?.some(token => relative.includes(token))
}
function eligible(relative, rules) {
  return (!rules.includes || rules.includes.includes(relative)) && (!rules.include_filter || rules.include_filter.some(regex => regex.test(relative))) && (!rules.exclude_filter || !rules.exclude_filter.some(regex => regex.test(relative)))
}
function source_boundary(context, relative, stat) {
  return relative !== "" && (stat.dev !== context.source_device || context.mounts.has(path.join(context.source,
    relative)))
}
async function select_directory(context, relative, stat, entries) {
  if (relative && excluded("/" + relative, context.rules)) return null
  if (relative && eligible("/" + relative, context.rules)) return {stat, children: null}
  const children = new Map()
  if (!source_boundary(context, relative, stat)) {
    entries ??= await fs.readdir(path.join(context.source, relative), {withFileTypes: true})
    for (const entry of entries) {
      if (!entry.isDirectory()) continue
      const child = relative ? relative + "/" + entry.name : entry.name
      const child_stat = await fs.lstat(path.join(context.source, child))
      const selected = await select_directory(context, child, child_stat)
      if (selected) children.set(entry.name, selected)
    }
  }
  return !relative || children.size ? {stat, children} : null
}
async function desired_children(context, relative, node) {
  if (node.children !== null) return node.children
  const children = new Map()
  if (source_boundary(context, relative, node.stat)) return children
  for (const entry of await fs.readdir(path.join(context.source, relative), {withFileTypes: true})) {
    const child = relative ? relative + "/" + entry.name : entry.name
    if (excluded("/" + child, context.rules)) continue
    const stat = await fs.lstat(path.join(context.source, child))
    if (stat.isDirectory() || (!source_boundary(context, child, stat) && (stat.isFile() || stat.isSymbolicLink()))) children.set(entry.name,
      {stat, children: null})
  }
  return children
}
function check_destination(context, filename, stat) {
  if (stat.dev !== context.destination_device || context.mounts.has(filename)) throw new Error("destination filesystem boundary: " + filename)
}
async function plan_remove(context, filename, stat, operations) {
  check_destination(context, filename, stat)
  if (stat.isDirectory()) {
    for (const name of await fs.readdir(filename)) {
      const child = path.join(filename, name)
      await plan_remove(context, child, await fs.lstat(child), operations)
    }
    operations.push(["rmdir", filename])
  } else {
    operations.push(["unlink", filename])
  }
}
function entry_type(stat) {
  if (stat.isDirectory()) return "directory"
  if (stat.isFile()) return "file"
  if (stat.isSymbolicLink()) return "link"
  return "other"
}
function mtime(stat) {
  return Math.round(stat.mtimeMs)
}
async function plan_entry(context, relative, node, destination_stat) {
  const source = path.join(context.source, relative)
  const destination = path.join(context.destination, relative)
  const type = entry_type(node.stat)
  if (destination_stat) {
    check_destination(context, destination, destination_stat)
    if (entry_type(destination_stat) !== type) {
      await plan_remove(context, destination, destination_stat, context.changes)
      destination_stat = null
    }
  }
  if (type === "directory") {
    if (!destination_stat) context.changes.push(["mkdir", destination])
    await plan_directory(context, relative, node, !!destination_stat)
  } else if (type === "file") {
    if (!destination_stat || node.stat.size !== destination_stat.size || mtime(node.stat) !== mtime(destination_stat)) context.changes.push(["copy",
      destination, source, node.stat])
  } else if (type === "link") {
    const target = await fs.readlink(source)
    if (!destination_stat || target !== await fs.readlink(destination)) context.changes.push(["link",
      destination, target])
  }
}
async function plan_directory(context, relative, node, exists) {
  const destination = path.join(context.destination, relative)
  const desired = await desired_children(context, relative, node)
  const existing = new Set(exists ? await fs.readdir(destination) : [])
  for (const [name, child] of desired) {
    const child_relative = relative ? relative + "/" + name : name
    const stat = existing.delete(name) ? await fs.lstat(path.join(destination, name)) : null
    await plan_entry(context, child_relative, child, stat)
  }
  for (const name of existing) {
    const filename = path.join(destination, name)
    await plan_remove(context, filename, await fs.lstat(filename), context.deletions)
  }
}
async function copy_file(source, temporary, stat) {
  if (stat.blocks * 512 < stat.size) {
    await execute("cp", ["--sparse=always", "--reflink=auto", "--", source, temporary])
  } else {
    await fs.copyFile(source, temporary, COPYFILE_FICLONE)
  }
  await fs.utimes(temporary, stat.atimeMs / 1000, mtime(stat) / 1000)
}
async function apply_plan(context, run) {
  let staging = null
  try {
    for (const operations of [context.changes, context.deletions]) {
      for (const [operation, filename, source, stat] of operations) {
        const label = operation === "unlink" || operation === "rmdir" ? "deleting" : operation
        console.log(label + " " + filename)
        if (!run) continue
        if (operation === "mkdir") await fs.mkdir(filename)
        else if (operation === "unlink") await fs.unlink(filename)
        else if (operation === "rmdir") await fs.rmdir(filename)
        else {
          staging ??= await fs.mkdtemp(path.join(context.destination, ".backup-disk-"))
          const temporary = path.join(staging, "entry")
          if (operation === "copy") await copy_file(source, temporary, stat)
          else await fs.symlink(source, temporary)
          await fs.rename(temporary, filename)
        }
      }
    }
  } finally {
    if (staging) await fs.rm(staging, {recursive: true, force: true})
  }
}
function contains(parent, child) {
  const relative = path.relative(parent, child)
  return !relative || (!path.isAbsolute(relative) && relative !== ".." && !relative.startsWith("../"))
}
async function synchronize(mount, entry, run) {
  const source = await try_path(fs.realpath, entry.source)
  const source_stat = source && await fs.lstat(source)
  const entries = source_stat?.isDirectory() && await fs.readdir(source, {withFileTypes: true})
  if (!entries?.length) {
    console.log("source path not accessible or empty: " + entry.source)
    return
  }
  const target = path.isAbsolute(entry.target) ? entry.target : path.join(mount, entry.target)
  const destination = await try_path(fs.realpath, target)
  const destination_stat = destination && await fs.lstat(destination)
  if (!destination_stat?.isDirectory()) {
    console.log("destination path is not an existing directory: " + target)
    return
  }
  if (source_stat.dev === destination_stat.dev && (contains(source, destination) || contains(destination,
    source))) throw new Error("source and destination overlap: " + source + " -> " + destination)
  const context = {source, destination, source_device: source_stat.dev,
    destination_device: destination_stat.dev, mounts: await mount_points(),
    rules: compile_rules(entry), changes: [], deletions: []}
  const selection = await select_directory(context, "", source_stat, entries)
  await plan_directory(context, "", selection, true)
  await apply_plan(context, run)
}
async function run_disk(uuid, entries, run) {
  let failed = false
  try {
    const mount = await mount_point(uuid)
    if (!mount) return false
    for (const entry of entries) {
      try {
        await synchronize(mount, entry, run)
      } catch (error) {
        failed = true
        console.error(uuid + ": " + error.message)
      }
    }
  } catch (error) {
    failed = true
    console.error(uuid + ": " + error.message)
  }
  return failed
}
async function main(args) {
  const {run, trigger, names} = parse_options(args)
  if (trigger) {
    execFileSync("udevadm", ["trigger", "--subsystem-match=block"], {stdio: "ignore"})
    execFileSync("sh", ["-lc", "blkid -p -o export /dev/mapper/* >/dev/null 2>&1"],
      {stdio: "ignore"})
    return
  }
  const directory = path.join(os.homedir(), ".config", "backup-disk")
  const files = names.length ? names.map(name => name + ".json") : (await fs.readdir(directory)).filter(name => name.endsWith(".json")).sort()
  const tasks = new Map()
  for (const file of files) {
    const groups = JSON.parse(await fs.readFile(path.join(directory, file), "utf8"))
    for (const group of groups) {
      for (const uuid of group.uuids) {
        if (!tasks.has(uuid)) tasks.set(uuid, [])
        tasks.get(uuid).push(...group.entries)
      }
    }
  }
  const results = await Promise.all(Array.from(tasks,
    ([uuid, entries]) => run_disk(uuid, entries, run)))
  if (results.some(Boolean)) process.exitCode = 1
}
main(process.argv.slice(2)).catch(error => {
  console.error(error.message)
  process.exitCode = 1
})
